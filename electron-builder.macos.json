{
  "appId": "com.a17press.wavedeck",
  "productName": "WaveDeck",
  "asar": true,
  "npmRebuild": false,
  "files": [
    "assets/**/*",
    "build/**/*",
    "defaults/**/*",
    "src/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "playback/darwin",
      "to": "playback/darwin"
    },
    {
      "from": "licenses/mpv-GPL-2.0.txt",
      "to": "licenses/mpv-GPL-2.0.txt"
    },
    {
      "from": "THIRD-PARTY-NOTICES.txt",
      "to": "THIRD-PARTY-NOTICES.txt"
    }
  ],
  "directories": {
    "output": "dist/macos"
  },
  "mac": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "universal"
        ]
      }
    ],
    "icon": "build/icon-macos.png",
    "category": "public.app-category.music",
    "minimumSystemVersion": "14.0",
    "identity": null
  }
}
