{
  "name": "wavedeck",
  "version": "0.7.6",
  "wavedeckVersion": "0.7.6",
  "description": "WaveDeck portable internet-radio player for Linux, Windows, and macOS",
  "author": "Andrew Riley",
  "license": "MIT",
  "desktopName": "wavedeck.desktop",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node scripts/ensure-music-dependencies.js",
    "prepare:linux-recorder": "node scripts/prepare-linux-ffmpeg.js",
    "start": "npm run prepare:linux-recorder && electron .",
    "test": "node scripts/validate.js && node scripts/test-music.js",
    "dist:linux": "npm run prepare:linux-recorder && electron-builder --linux AppImage --x64",
    "dist:windows": "electron-builder --win portable --x64 --config electron-builder.windows.json",
    "dist:macos": "electron-builder --mac dir --universal --config electron-builder.macos.json"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.a17press.wavedeck",
    "productName": "WaveDeck",
    "asar": true,
    "files": [
      "assets/**/*",
      "build/**/*",
      "defaults/**/*",
      "src/**/*",
      "package.json",
      "!node_modules/usocket{,/**/*}"
    ],
    "extraResources": [
      {
        "from": ".cache/wavedeck-tools/linux/ffmpeg",
        "to": "recording/ffmpeg"
      },
      {
        "from": ".cache/wavedeck-tools/linux/ffprobe",
        "to": "recording/ffprobe"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "WaveDeck.${ext}"
    }
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "music-metadata": "11.9.0",
    "sql.js": "1.13.0",
    "x11": "^4.1.0"
  }
}
