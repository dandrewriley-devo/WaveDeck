{
  "name": "wavedeck",
  "version": "0.6.0",
  "description": "WaveDeck portable internet-radio player for Linux, Windows, and macOS",
  "author": "Andrew Riley",
  "license": "MIT",
  "desktopName": "wavedeck.desktop",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/validate.js",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:windows": "electron-builder --win portable --x64 --config electron-builder.windows.json",
    "dist:macos": "electron-builder --mac dir --universal --config electron-builder.macos.json"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.a17press.wavedeck",
    "productName": "WaveDeck",
    "asar": true,
    "files": [
      "assets/**/*",
      "build/**/*",
      "defaults/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "WaveDeck.${ext}"
    }
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "x11": "^4.1.0"
  }
}
